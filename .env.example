# LLM provider: "gemini" | "groq" | "mock" (auto = first available key)
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Narration: "gemini" | "none" (none = browser Web Speech fallback only)
TTS_PROVIDER=gemini
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# Max TTS calls per pipeline run (free tier daily quota is small)
TTS_MAX_PER_RUN=10

# Pipeline
PIPELINE_MAX_STORIES_PER_TRACK=4
