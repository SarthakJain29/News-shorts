# ── Scripts (LLM) ────────────────────────────────────────────────────────────
# Groq is the default writer (free key: https://console.groq.com/keys). Nothing requires Gemini.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b,openai/gpt-oss-20b
# auto = Groq, then Gemini if a key is present | groq | gemini | mock (offline writer, no API calls)
LLM_PROVIDER=auto
# Optional extra fallback only:
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# ── Narration: Kokoro-82M runs locally on CPU — no key, no quota ─────────────
# Providers in order. "kokoro" is local; "gemini" is optional and needs GEMINI_API_KEY + quota.
TTS_PROVIDERS=kokoro,gemini
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha
KOKORO_SPEED=1
# Stop narrating after N minutes (remaining shorts are done next run). 0 = no limit. CI uses 40.
NARRATE_BUDGET_MIN=0

# ── Exact captions: word timestamps from Whisper ─────────────────────────────
# Order of recognisers: Groq whisper-large-v3-turbo (needs GROQ_API_KEY), then local Whisper, then segment-level timing.
ALIGN_ENGINES=groq,local

# ── Story clustering: local MiniLM embeddings (no key) ───────────────────────
EMBED=1
EMBED_THRESHOLD=0.6

# ── Hindi ────────────────────────────────────────────────────────────────────
# Tracks that also get a Hindi script + Kokoro Hindi narration (needs `espeak-ng` installed).
HINDI_TRACKS=india

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_MAX_STORIES_PER_TRACK=4
# Where transformers.js caches model weights (cache this folder in CI)
# MODEL_CACHE_DIR=pipeline/.cache/models

# ── Audio storage (optional). Default = commit MP3s to public/audio (works today). ──
# For a lean repo use any S3-compatible bucket — Cloudflare R2's free tier is recommended (see developer.md).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PREFIX=audio/
AUDIO_PUBLIC_URL=
